# Copy to deploy/vps/.env (or the host's release directory) and fill in.
# URL-safe random value, e.g. openssl rand -hex 24
ARIL_DB_PASSWORD=
ARIL_ORIGIN=https://www.aril.studio
# Comma-separated exact origins; no wildcards.
ARIL_ADDITIONAL_ORIGINS=https://aril.studio
# Google Identity Services web client ID (not a secret).
GOOGLE_CLIENT_ID=
# Loopback port published for the reverse proxy.
ARIL_PORT=4317
ARIL_BACKUP_DIR=./backups

# Optional file with further server settings from the root .env.example
# (YANDEX_*, OIDC_*, RESEND_API_KEY, ARIL_EMAIL_FROM, ARIL_PRODUCT_*).
ARIL_APP_ENV_FILE=./app.env
