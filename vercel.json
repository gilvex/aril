{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "apps/studio/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "apps/studio/.server/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    }
  ]
}
