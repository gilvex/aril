{
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "name": "aril",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --filter @aril/studio dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint . && node scripts/checkArchitecture.mjs",
    "test": "pnpm --filter @aril/studio test",
    "benchmark:collaboration": "node scripts/benchmarkCollaboration.ts",
    "verify:recovery": "node scripts/verifyRecovery.ts",
    "start": "pnpm --filter @aril/studio start",
    "invite": "node --env-file-if-exists=.env scripts/invite.ts",
    "mcp": "pnpm --filter @aril/mcp start",
    "mcp:setup": "pnpm --filter @aril/mcp setup",
    "skill:install": "pnpm --filter @aril/studio-skill install:skill",
    "check:architecture": "node scripts/checkArchitecture.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@aril/domain": "workspace:*",
    "@supabase/realtime-js": "^2.117.2",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright": "1.63.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
