# Optional Google Identity Services web client ID (not a client secret).
# Register http://127.0.0.1:5173 and your production HTTPS origin in Google Cloud.
GOOGLE_CLIENT_ID=

# Set only when hosting behind your own HTTPS reverse proxy.
# POMEGRANATE_ORIGIN=https://studio.example.com
# Optional additional exact origins, comma-separated (no wildcard hosts).
# POMEGRANATE_ADDITIONAL_ORIGINS=https://another-studio.example.com
# HOST=127.0.0.1
# PORT=4317
# POMEGRANATE_DATA_DIR=data

# Optional shared Postgres backend. Local defaults to SQLite; Vercel uses Postgres.
# POMEGRANATE_STORAGE=postgres
# POSTGRES_URL=postgresql://user:password@host:6543/postgres
# POMEGRANATE_CLOUD_ORIGIN=https://arilapp.vercel.app

# Postgres deployments use private Supabase WebSocket channels for live sessions.
# Install channel policies once with node --env-file=.env scripts/setup-realtime.ts.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_JWT_SECRET=your-server-only-jwt-signing-secret
