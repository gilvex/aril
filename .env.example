# Optional Google Identity Services web client ID (not a client secret).
# Register http://127.0.0.1:5173 and your production HTTPS origin in Google Cloud.
GOOGLE_CLIENT_ID=

# Set only when hosting behind your own HTTPS reverse proxy.
# ARIL_ORIGIN=https://studio.example.com
# Optional additional exact origins, comma-separated (no wildcard hosts).
# ARIL_ADDITIONAL_ORIGINS=https://another-studio.example.com
# HOST=127.0.0.1
# PORT=4317
# ARIL_DATA_DIR=data

# Optional shared Postgres backend. Local defaults to SQLite; Vercel uses Postgres.
# ARIL_STORAGE=postgres
# POSTGRES_URL=postgresql://user:password@host:6543/postgres
# Single long-running process with Postgres: push saves and presence in memory
# instead of polling and Supabase Realtime. See docs/self-hosting.md.
# ARIL_LIVE_TRANSPORT=local
# ARIL_CLOUD_ORIGIN=https://arilapp.vercel.app

# Postgres deployments use private Supabase WebSocket channels for live sessions.
# Install channel policies once with node --env-file=.env scripts/setup-realtime.ts.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_JWT_SECRET=your-server-only-jwt-signing-secret

# Optional Yandex ID. Redirect URI: <ARIL_ORIGIN>/api/auth/yandex/callback
# Request login:info and login:email in the Yandex OAuth application.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Optional confidential OpenID Connect client (Keycloak, Authentik, etc.).
# Redirect URI: <ARIL_ORIGIN>/api/auth/oidc/callback
# Discovery issuer must match exactly, including any trailing slash.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISPLAY_NAME=SSO

# Self-hosted default: studio sign-in only. Source-code links remain available.
# Set true to preview the public landing/demo; unset to detect the configured aril.studio origin.
ARIL_PRODUCT_SITE_ENABLED=false

# Optional display branding (runtime settings; no rebuild required).
ARIL_PRODUCT_NAME=Aril
# Absolute HTTP(S) image URL or root-relative path. Empty uses the built-in logo.
ARIL_PRODUCT_LOGO_URL=

# Optional invitation email delivery (server-only). Verify the sender domain in Resend.
# Invitation links use ARIL_ORIGIN; configure its public HTTPS URL.
RESEND_API_KEY=
ARIL_EMAIL_FROM=
